# Copy to backend/.env and fill in once you create a Supabase project.
# If left unset, the app automatically falls back to a local JSON-file
# store (backend/data/local_db.json) so you can run and demo it immediately.

HIREMIND_SECRET_KEY=change-me-in-production
FLASK_DEBUG=1

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
